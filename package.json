{
  "name": "the-curb",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typegen": "next typegen",
    "test": "node --test \"tests/*.test.ts\"",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "verify:store": "node --env-file-if-exists=.env.local --test \"tests/store-*.test.ts\"",
    "db:prune": "node --env-file-if-exists=.env.local scripts/prune.ts",
    "db:dump": "node --env-file-if-exists=.env.local scripts/dump.ts",
    "db:restore": "node --env-file-if-exists=.env.local scripts/dump.ts --restore",
    "probe:rpc": "node --env-file-if-exists=.env.local scripts/probe-rpc.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "next": "16.3.4",
    "postgres": "^3.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.7.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
